model Address {
    id     String @id @default(uuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    fullName    String
    phoneNumber String
    addressLine String
    city        String
    area        String?
    postalCode  String?
    isDefault   Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("addresses")
}
