enum Gender {
    MALE
    FEMALE
    OTHER
    NOT_SPECIFIED
}

model UserProfileMaster {
    id          String  @id
    image       String?
    email       String? @unique
    phoneNumber String? @unique

    profile   Profile?
    addresses Address[]

    isDeleted Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user_profiles")
}

model Profile {
    id     String            @id @default(uuid())
    userId String            @unique
    user   UserProfileMaster @relation(fields: [userId], references: [id], onDelete: Cascade)

    firstName   String?
    lastName    String?
    gender      Gender    @default(NOT_SPECIFIED)
    dateOfBirth DateTime?
    bio         String?   @db.Text

    hasReturnRequests Boolean @default(false)
    loyaltyVerified   Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@map("profiles")
}

model Address {
    id     String            @id @default(uuid())
    userId String
    user   UserProfileMaster @relation(fields: [userId], references: [id], onDelete: Cascade)

    fullName    String
    phoneNumber String
    addressLine String
    city        String
    area        String?
    postalCode  String?
    country     String  @default("Bangladesh")
    isDefault   Boolean @default(false)

    isDeleted Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@map("addresses")
}
