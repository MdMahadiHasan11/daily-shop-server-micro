enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum VariantStrategy {
  FEFO_FIRST
  COST_FIRST
  CENTRAL_HUB_FIRST
}

enum StockTransactionType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  STOCK_EXPIRED
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// ==========================================
// 1. PRODUCT VARIANT (Required for Inventory Relations)
// ==========================================
model ProductVariant {
  id            String          @id @default(uuid())
  productId     String
  sku           String          @unique
  barcode       String?         @unique
  strategy      VariantStrategy @default(FEFO_FIRST)
  name          String
  price         Float
  discountPrice Float?
  costPrice     Float?
  unit          String
  weightValue   Float?
  attributes    Json?
  images        String[]
  isDefault     Boolean         @default(false)
  isDeleted     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Inventory Relations
  stocks              StockLevel[]
  stockBatches        StockBatch[]
  stockTransactions   StockTransaction[]
  purchaseOrderItems  PurchaseOrderItem[]
  transferItems       StockTransferItem[]
  expiredStockBatches ExpiredStockBatch[]

  @@index([sku])
  @@map("product_variants")
}

// ==========================================
// 2. WAREHOUSE / OUTLET MODEL 
// ==========================================
model Warehouse {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  address   String?
  isMain    Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stocks              StockLevel[]
  stockBatches        StockBatch[]
  stockTransactions   StockTransaction[]
  purchaseOrders      PurchaseOrder[]
  transfersFrom       StockTransfer[]     @relation("TransferFrom")
  transfersTo         StockTransfer[]     @relation("TransferTo")
  expiredStockBatches ExpiredStockBatch[]

  @@map("warehouses")
}

// ==========================================
// 3. SUPPLIER / VENDOR MODEL 
// ==========================================
model Supplier {
  id            String   @id @default(uuid())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

// ==========================================
// 4. STOCK LEVEL MODEL 
// ==========================================
model StockLevel {
  id               String         @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  quantity         Int @default(0)
  reservedQuantity Int @default(0)
  reorderLevel     Int @default(10)
  reorderQuantity  Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@unique([warehouseId, productVariantId])
  @@index([warehouseId])
  @@index([productVariantId])
  @@map("stock_levels")
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  DAMAGED
  QUARANTINED
}

// ==========================================
// 5. STOCK BATCH / LOT MODEL 
// ==========================================
model StockBatch {
  id               String         @id @default(uuid())
  batchNumber      String         @unique
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  status           BatchStatus    @default(ACTIVE)
  initialQuantity  Int
  currentQuantity  Int
  reservedQuantity Int            @default(0)
  purchasePrice    Float?
  mfgDate          DateTime?
  expiryDate       DateTime?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productVariantId])
  @@index([warehouseId])
  @@index([expiryDate])
  @@index([status])
  @@map("stock_batches")
}

// ==========================================
// 6. STOCK TRANSACTION / LEDGER 
// ==========================================
model StockTransaction {
  id               String         @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  type        StockTransactionType
  quantity    Int
  referenceId String?
  note        String?
  createdBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([warehouseId])
  @@index([productVariantId])
  @@index([type])
  @@map("stock_transactions")
}

// ==========================================
// 7. PURCHASE ORDER (PO) & ITEMS 
// ==========================================
model PurchaseOrder {
  id          String    @id @default(uuid())
  poNumber    String    @unique
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status       PurchaseOrderStatus @default(PENDING)
  totalAmount  Float               @default(0)
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String?

  items     PurchaseOrderItem[]
  isDeleted Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String         @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  orderedQuantity  Int
  receivedQuantity Int      @default(0)
  unitCost         Float
  totalCost        Float
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("purchase_order_items")
}

// ==========================================
// 8. WAREHOUSE-TO-WAREHOUSE STOCK TRANSFER
// ==========================================
model StockTransfer {
  id              String    @id @default(uuid())
  transferNumber  String    @unique
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  status TransferStatus      @default(PENDING)
  notes  String?
  items  StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@map("stock_transfers")
}

model StockTransferItem {
  id               String         @id @default(uuid())
  transferId       String
  transfer         StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  quantity  Int
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_transfer_items")
}

// ==========================================
// 9. EXPIRED STOCK BATCH MODEL (For Cron Job / Archiving)
// ==========================================
model ExpiredStockBatch {
  id               String         @id @default(uuid())
  originalBatchId  String
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  batchNumber     String
  expiredQuantity Int
  purchasePrice   Float?
  mfgDate         DateTime?
  expiryDate      DateTime?
  reason          String    @default("Automatic expired by midnight cron job")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productVariantId])
  @@index([warehouseId])
  @@index([expiryDate])
  @@map("expired_stock_batches")
}
